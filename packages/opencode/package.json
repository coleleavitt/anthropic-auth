{
  "name": "@cortexkit/opencode-anthropic-auth",
  "version": "999.0.0-dev.20260825",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cortexkit/anthropic-auth.git",
    "directory": "packages/opencode"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/v2/server.js",
      "types": "./dist/v2/server.d.ts"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./src/tui/entry.mjs"
    },
    "./tui-prefs": {
      "types": "./dist/tui-preferences.d.ts",
      "import": "./dist/tui-preferences.js"
    }
  },
  "oc-plugin": [
    "server",
    "tui"
  ],
  "bin": {
    "opencode-anthropic-auth": "dist/cli.js"
  },
  "engines": {
    "bun": "1.3.14"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "server.js",
    "src/rpc",
    "src/sidebar-state.ts",
    "src/tui",
    "src/tui-compiled",
    "src/tui-preferences.ts",
    "src/tui.tsx",
    "tui.js"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts src/v2/server.ts src/cli.ts src/sidebar-state.ts src/tui-preferences.ts src/rpc/rpc-client.ts src/rpc/port-file.ts src/rpc/protocol.ts src/rpc/rpc-dir.ts --outdir dist --root src --target node --format esm --splitting --external @opencode-ai/plugin --external @coleleavitt/anthropic-napi --minify && tsc -p tsconfig.build.json --emitDeclarationOnly && bun run build:tui",
    "build:tui": "bun scripts/build-tui.ts",
    "smoke:tui": "bun scripts/smoke-tui-pack-install.ts",
    "build:dev": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "bun ../../scripts/dev.ts",
    "dev:clean": "bun ../../scripts/dev-clean.ts",
    "extract": "bun ../../scripts/extract-system-prompt.ts",
    "test": "bun ../../scripts/test-isolated.ts src/tests",
    "typecheck": "tsc && tsc -p tsconfig.scripts.json",
    "types": "tsc && tsc -p tsconfig.scripts.json",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*"
  },
  "dependencies": {
    "@coleleavitt/anthropic-napi": "file:../../../../../RustProjects/active/anthropic/anthropic-napi",
    "@cortexkit/anthropic-auth-core": "999.0.0-dev.20260825",
    "@opentui/core": "0.5.6",
    "@opentui/solid": "0.5.6",
    "jsonc-parser": "^3.3.1",
    "solid-js": "1.9.12"
  }
}
